# Google Sheets Integration (Meta Flows)
# Create an OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must match GOOGLE_SHEETS_REDIRECT_URI below
GOOGLE_SHEETS_CLIENT_ID=
GOOGLE_SHEETS_CLIENT_SECRET=
GOOGLE_SHEETS_REDIRECT_URI=https://yourdomain.com/automation/meta-flows/google/callback

# Contact imports
CONTACT_IMPORT_PROCESSING_CHUNK_SIZE=3000
CONTACT_IMPORT_LARGE_FILE_READ_CHUNK_SIZE=10000
CONTACT_IMPORT_CONTACT_WRITE_CHUNK_SIZE=1500
CONTACT_IMPORT_PIVOT_WRITE_CHUNK_SIZE=5000
CONTACT_IMPORT_PROGRESS_UPDATE_INTERVAL=20000

# Telescope is useful for local debugging, but it adds database writes to requests.
TELESCOPE_ENABLED=false

# Safe re-entry through portal options in previously sent Flow Builder menus.
FLOW_STALE_PORTAL_REENTRY_ENABLED=false
FLOW_STALE_PORTAL_REENTRY_ORGANIZATIONS=

# Zid Integration OAuth2 settings
ZID_CLIENT_ID=
ZID_CLIENT_SECRET=
ZID_REDIRECT_URI=https://yourdomain.com/zid/callback
ZID_SCOPES="read write"
ZID_AUTH_URL=https://oauth.zid.sa/oauth/authorize
ZID_TOKEN_URL=https://oauth.zid.sa/oauth/token
ZID_MANAGER_PROFILE_URL=https://api.zid.sa/v1/managers/account/profile
ZID_WEBHOOK_TARGET=https://dashboard.chatberry.net/api/integrations/zid/webhook

# Campaign Processing
QUEUE_CONNECTION=redis
NOTIFICATION_QUEUE_CONNECTION=redis
NOTIFICATION_SENDER_EMAILS=
NOTIFICATION_WEBHOOK_ALLOWED_HOSTS=
NOTIFICATION_RETENTION_DAYS=180

# Firebase Cloud Messaging
# Absolute path to the Firebase service-account JSON file.
FIREBASE_CREDENTIALS=
# Alternative to FIREBASE_CREDENTIALS: the service-account JSON as a string.
FIREBASE_CREDENTIALS_JSON=

CAMPAIGN_THROTTLE_ENABLED=true
CAMPAIGN_DEFAULT_PHONE_MPS=20
CAMPAIGN_MAX_PHONE_MPS=80
CAMPAIGN_RATE_LIMIT_BACKOFF_SECONDS=120
CAMPAIGN_SUCCESS_LOG_SAMPLE_RATE=0.01
CAMPAIGN_DISPATCH_WAVE_SIZE=2100
CAMPAIGN_DISPATCH_PER_CAMPAIGN_WAVE_SIZE=700
CAMPAIGN_REDISPATCH_DELAY_SECONDS=5
CAMPAIGN_DISPATCH_LOCK_SECONDS=30
CAMPAIGN_DISPATCH_RESERVATION_TTL_SECONDS=900
CAMPAIGN_LOGS_QUEUE=campaign-logs
CAMPAIGN_DISPATCHERS_QUEUE=campaign-dispatchers
CAMPAIGN_MESSAGES_QUEUE=campaign-messages
CAMPAIGN_POST_SEND_QUEUE=campaign-post-send

CAMPAIGN_BATCH_SIZE=1000
CAMPAIGN_MAX_BATCH_SIZE=1000

# Campaign Retry
CAMPAIGN_RETRY_INTERVALS=5,15,60
CAMPAIGN_MAX_RETRIES=3
CAMPAIGN_LOG_PERMANENT_FAILURES=true

# Campaign Chunk Processing
CAMPAIGN_CHUNK_SIZE=100
CAMPAIGN_CONCURRENCY=2
CAMPAIGN_REQUEST_DELAY_MS=100
CAMPAIGN_LOAD_TEST_MODE=false

# Chatbot Studio: choose one provider explicitly; never auto-fallback.
CHATBOT_STUDIO_AI_PROVIDER=gemini
CHATBOT_STUDIO_GEMINI_API_KEY=
CHATBOT_STUDIO_FREE_TIER_CONFIRMED=false
CHATBOT_STUDIO_DEEPSEEK_API_KEY=
CHATBOT_STUDIO_PAID_USAGE_CONFIRMED=false
# For DeepSeek set CHATBOT_STUDIO_AI_PROVIDER=deepseek and model=deepseek-flash.
CHATBOT_STUDIO_AI_MODEL=gemini-3.8-flash
CHATBOT_STUDIO_OUTPUT_TOKENS=24000
CHATBOT_STUDIO_REQUEST_TIMEOUT=240
