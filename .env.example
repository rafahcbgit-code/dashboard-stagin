# Google Sheets Integration (Meta Flows)
# Create an OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must match GOOGLE_SHEETS_REDIRECT_URI below
GOOGLE_SHEETS_CLIENT_ID=
GOOGLE_SHEETS_CLIENT_SECRET=
GOOGLE_SHEETS_REDIRECT_URI=https://yourdomain.com/automation/meta-flows/google/callback

# Contact imports
CONTACT_IMPORT_PROCESSING_CHUNK_SIZE=3000
CONTACT_IMPORT_LARGE_FILE_READ_CHUNK_SIZE=10000
CONTACT_IMPORT_CONTACT_WRITE_CHUNK_SIZE=1500
CONTACT_IMPORT_PIVOT_WRITE_CHUNK_SIZE=5000
CONTACT_IMPORT_PROGRESS_UPDATE_INTERVAL=20000

# Zid Integration OAuth2 settings
ZID_CLIENT_ID=
ZID_CLIENT_SECRET=
ZID_REDIRECT_URI=https://yourdomain.com/zid/callback
ZID_SCOPES="read write"
ZID_AUTH_URL=https://oauth.zid.sa/oauth/authorize
ZID_TOKEN_URL=https://oauth.zid.sa/oauth/token
ZID_MANAGER_PROFILE_URL=https://api.zid.sa/v1/managers/account/profile
ZID_WEBHOOK_TARGET=https://dashboard.chatberry.net/api/integrations/zid/webhook
