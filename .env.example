# Google Sheets Integration (Meta Flows)
# Create an OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must match GOOGLE_SHEETS_REDIRECT_URI below
GOOGLE_SHEETS_CLIENT_ID=
GOOGLE_SHEETS_CLIENT_SECRET=
GOOGLE_SHEETS_REDIRECT_URI=https://yourdomain.com/automation/meta-flows/google/callback
